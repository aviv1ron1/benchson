{
  "name": "o41348",
  "source": "jsonschemabench",
  "subset": "Github_medium",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "required": [
      "config",
      "inputs"
    ],
    "type": "object",
    "properties": {
      "inputs": {
        "required": [
          "raw",
          "sin",
          "lab"
        ],
        "type": "object",
        "properties": {
          "raw": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "Philips Raw file"
                ]
              }
            }
          },
          "user_stylesheet": {
            "type": "object",
            "properties": {
              "name": {
                "pattern": "^.*.xsl$"
              }
            }
          },
          "sin": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "Philips Sin file"
                ]
              }
            }
          },
          "lab": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "Philips Lab file"
                ]
              }
            }
          }
        }
      },
      "config": {
        "required": [
          "debug"
        ],
        "type": "object",
        "properties": {
          "debug": {
            "default": false,
            "type": "boolean"
          }
        }
      }
    },
    "title": "Invocation manifest for Philips to ISMRM-RD Converter (philips_to_ismrmrd v0.1.0, ismrmrd v1.3.2)"
  },
  "erroneous_json": {
    "config": null,
    "inputs": {
      "raw": {
        "type": "Philips Raw file"
      },
      "sin": {
        "type": "Philips Sin file"
      },
      "lab": {
        "type": "Philips Lab file"
      },
      "user_stylesheet": {
        "name": "transform.xsl"
      }
    }
  },
  "valid_json": {
    "config": {
      "debug": false
    },
    "inputs": {
      "raw": {
        "type": "Philips Raw file"
      },
      "sin": {
        "type": "Philips Sin file"
      },
      "lab": {
        "type": "Philips Lab file"
      },
      "user_stylesheet": {
        "name": "transform.xsl"
      }
    }
  },
  "description": "The conversion job for the Philips data set will run with debugging turned off. All three source files have been identified correctly: the raw acquisition is a Philips Raw file, the accompanying sin file is a Philips Sin file, and the calibration data is a Philips Lab file. In addition, the custom XSL transformation to be applied is the stylesheet named **transform.xsl**."
}