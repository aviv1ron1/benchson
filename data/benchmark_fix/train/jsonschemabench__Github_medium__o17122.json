{
  "name": "o17122",
  "source": "jsonschemabench",
  "subset": "Github_medium",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Config",
    "description": "A Config Object for verbshaker",
    "type": "object",
    "properties": {
      "port": {
        "description": "The Port the Server is listening to",
        "type": "integer"
      },
      "proverbs": {
        "description": "The Server-Path to the Proverbs",
        "type": "string"
      },
      "show_docs": {
        "description": "Allow path /docs",
        "type": "boolean"
      },
      "default": {
        "description": "Default Values",
        "type": "object",
        "properties": {
          "backgroundcolor": {
            "description": "Color of the Background as (HEX)",
            "type": "string"
          },
          "fontcolor": {
            "description": "Default Color of the Font (HEX)",
            "type": "string"
          },
          "fontsize": {
            "description": "Default Size of the Font (in vmin)",
            "type": "integer"
          },
          "fontfamily": {
            "description": "Default Family of the Font",
            "type": "string"
          },
          "hiddenNav": {
            "description": "Is the Navbar Hidden",
            "type": "boolean"
          },
          "proverbbutton": {
            "description": "Is the proverbbutton shown",
            "type": "boolean"
          },
          "autoupdate": {
            "description": "AutoUpdate Value for Proverbs",
            "type": "integer"
          },
          "shareButton": {
            "description": "Is the ShareButton shown",
            "type": "boolean"
          },
          "unhideNavButton": {
            "description": "Is the Button to show the Navbar shown",
            "type": "boolean"
          },
          "introjs": {
            "description": "Use intro.js to show new users around",
            "type": "boolean"
          }
        }
      },
      "changeable": {
        "description": "Defines what the user may edit",
        "type": "object",
        "properties": {
          "language": {
            "description": "Change the language",
            "type": "boolean"
          },
          "backgroundcolor": {
            "description": "Change the Color of the Background",
            "type": "boolean"
          },
          "fontcolor": {
            "description": "Change the Color of the Font",
            "type": "boolean"
          },
          "fontsize": {
            "description": "Change the Size of the Font",
            "type": "boolean"
          },
          "fontfamily": {
            "description": "Change the Family of the Font",
            "type": "boolean"
          },
          "hideNav": {
            "description": "Allow to Hide the Navbar",
            "type": "boolean"
          },
          "proverbbutton": {
            "description": "Toggle proverb-Button",
            "type": "boolean"
          },
          "autoupdate": {
            "description": "Change the Autoupdate Value",
            "type": "boolean"
          }
        }
      }
    }
  },
  "erroneous_json": {
    "port": 8080,
    "proverbs": "/data/proverbs.json",
    "show_docs": "not-a-bool",
    "default": {
      "backgroundcolor": "#ffffff",
      "fontcolor": "#000000",
      "fontsize": 2,
      "fontfamily": "Arial, Helvetica, sans-serif",
      "hiddenNav": false,
      "proverbbutton": true,
      "autoupdate": 60,
      "shareButton": true,
      "unhideNavButton": false,
      "introjs": true
    },
    "changeable": {
      "language": true,
      "backgroundcolor": true,
      "fontcolor": true,
      "fontsize": true,
      "fontfamily": true,
      "hideNav": true,
      "proverbbutton": true,
      "autoupdate": false
    }
  },
  "valid_json": {
    "port": 8080,
    "proverbs": "/data/proverbs.json",
    "show_docs": true,
    "default": {
      "backgroundcolor": "#ffffff",
      "fontcolor": "#000000",
      "fontsize": 2,
      "fontfamily": "Arial, Helvetica, sans-serif",
      "hiddenNav": false,
      "proverbbutton": true,
      "autoupdate": 60,
      "shareButton": true,
      "unhideNavButton": false,
      "introjs": true
    },
    "changeable": {
      "language": true,
      "backgroundcolor": true,
      "fontcolor": true,
      "fontsize": true,
      "fontfamily": true,
      "hideNav": true,
      "proverbbutton": true,
      "autoupdate": false
    }
  },
  "description": "The server is set to listen on port\u202f8080 and will load its collection of sayings from the file located at **/data/proverbs.json**. Access to the API documentation under the **/docs** endpoint is enabled, so users can explore the available routes.\n\nBy default the interface uses a clean white background (**#ffffff**) with black text (**#000000**). The base font size is\u202f2\u202fvmin and the typeface is \u201cArial, Helvetica, sans-serif\u201d. The navigation bar is visible (it is not hidden), the proverb button is shown, and the share button is also active, while the button that would unhide the navigation bar is turned off. Proverbs are refreshed automatically every\u202f60\u202fseconds, and the introductory guide powered by\u202fintro.js\u202fis enabled. Users are allowed to customize the language, background colour, font colour, font size, font family, the ability to hide the navigation bar, and the proverb button; however, the auto\u2011update interval is fixed and cannot be altered."
}