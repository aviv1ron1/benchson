          "type": {
            "$ref": "azure-deviceupdate-manifest-definitions-5.0.json#/definitions/referenceStepType"
          },
          "description": {
            "$ref": "#/definitions/stepDescription"
          },
          "updateId": {
            "$ref": "azure-deviceupdate-manifest-definitions-5.0.json#/definitions/updateId"
