{
  "name": "o27350",
  "source": "jsonschemabench",
  "subset": "Github_easy",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Build metadata plugin manifest",
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "enum": [
          "ec2"
        ]
      },
      "plugins": {
        "type": "object",
        "properties": {
          "build_metadata": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ]
          }
        },
        "required": [
          "build_metadata"
        ]
      }
    },
    "required": [
      "plugins"
    ]
  },
  "erroneous_json": {
    "provider": "ec2",
    "plugins": null
  },
  "valid_json": {
    "provider": "ec2",
    "plugins": {
      "build_metadata": {
        "path": "/opt/build/plugins/metadata"
      }
    }
  },
  "description": "The current deployment is set to use the EC2 provider, and the build\u2011metadata plugin has been configured accordingly. Its executable resides at **/opt/build/plugins/metadata**, which is the location the system will reference when generating build information."
}