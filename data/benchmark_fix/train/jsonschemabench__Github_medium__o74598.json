{
  "name": "o74598",
  "source": "jsonschemabench",
  "subset": "Github_medium",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Widgets",
    "type": "object",
    "definitions": {
      "cloudstatus": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "enum": [
              "amazon",
              "digitalOcean",
              "google",
              "joyent",
              "linode",
              "rackspace",
              "salesforce",
              "softlayer",
              "windowsAzure"
            ]
          },
          "feedUrl": {
            "type": "string"
          }
        },
        "required": [
          "providerId",
          "feedUrl"
        ]
      },
      "elasticGraph": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object"
          },
          "type": {
            "type": "string",
            "enum": [
              "line",
              "area"
            ]
          },
          "searchFilter": {
            "type": "string"
          },
          "tall": {
            "type": "boolean"
          },
          "seriesStates": {
            "type": "object",
            "properties": {
              "series": {
                "type": "object",
                "properties": {
                  "^\\w+{24}: .+": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right",
                      "disabled"
                    ]
                  }
                }
              }
            }
          },
          "sectionFilter": {
            "type": "string"
          }
        },
        "required": [
          "filter",
          "type",
          "searchFilter"
        ]
      },
      "graph": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object"
          },
          "type": {
            "type": "string",
            "enum": [
              "line",
              "area"
            ]
          },
          "tall": {
            "type": "boolean"
          },
          "seriesStates": {
            "type": "object",
            "properties": {
              "series": {
                "type": "object",
                "properties": {
                  "^\\w+{24}: .+": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right",
                      "disabled"
                    ]
                  }
                }
              }
            }
          }
        },
        "required": [
          "filter",
          "type"
        ]
      },
      "rss": {
        "type": "object",
        "properties": {
          "feedUrl": {
            "type": "string"
          }
        },
        "required": [
          "feedUrl"
        ]
      },
      "serviceStatus": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "format": "mongoId"
          }
        },
        "required": [
          "serviceId"
        ]
      },
      "openAlerts": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "device",
              "serviceGroup",
              "deviceGroup",
              "service"
            ]
          },
          "isGroup": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "properties": {
      "dashboardId": {
        "type": "string",
        "format": "mongoId"
      },
      "type": {
        "type": "string",
        "enum": [
          "cloudstatus",
          "elasticGraph",
          "graph",
          "openAlerts",
          "rss",
          "serviceStatus"
        ]
      },
      "config": {
        "oneOf": [
          {
            "$ref": "#/definitions/elasticGraph"
          },
          {
            "$ref": "#/definitions/cloudstatus"
          },
          {
            "$ref": "#/definitions/graph"
          },
          {
            "$ref": "#/definitions/rss"
          },
          {
            "$ref": "#/definitions/serviceStatus"
          },
          {
            "$ref": "#/definitions/openAlerts"
          }
        ]
      }
    },
    "required": [
      "dashboardId",
      "type",
      "config"
    ]
  },
  "erroneous_json": {
    "dashboardId": "5f8d0d55b54764421b7156c3",
    "type": null,
    "config": {
      "filter": {
        "status": "active"
      },
      "type": "area",
      "tall": false,
      "seriesStates": {
        "series": {
          "5f8d0d55b54764421b7156c5: cpu": "left",
          "5f8d0d55b54764421b7156c6: memory": "disabled"
        }
      }
    }
  },
  "valid_json": {
    "dashboardId": "5f8d0d55b54764421b7156c3",
    "type": "graph",
    "config": {
      "filter": {
        "status": "active"
      },
      "type": "area",
      "tall": false,
      "seriesStates": {
        "series": {
          "5f8d0d55b54764421b7156c5: cpu": "left",
          "5f8d0d55b54764421b7156c6: memory": "disabled"
        }
      }
    }
  },
  "description": "The performance dashboard identified by\u202f5f8d0d55b54764421b7156c3 includes a single graph widget. This widget is of the \u201cgraph\u201d type and is configured to display an area\u2011style chart.\n\nThe chart is filtered to show only items whose status is \u201cactive,\u201d and it is set to the standard height (the \u201ctall\u201d option is disabled). In the series configuration, the data series identified by the ID\u202f5f8d0d55b54764421b7156c5 and labeled \u201ccpu\u201d is plotted on the left axis, while the series with ID\u202f5f8d0d55b54764421b7156c6 labeled \u201cmemory\u201d is currently disabled."
}