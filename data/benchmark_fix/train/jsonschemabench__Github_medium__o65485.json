{
  "name": "o65485",
  "source": "jsonschemabench",
  "subset": "Github_medium",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Memote Experimental Tests Configuration Schema",
    "description": "Validate an experimental data configuration file that defines additional memote tests.",
    "definitions": {
      "stringSet": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "_uniqueItems": true
      },
      "fileName": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^.+\\.(csv|tsv|xls|xlsx|ods)$"
      },
      "experiment": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "filename": {
            "$ref": "#/definitions/fileName"
          },
          "medium": {
            "type": [
              "string",
              "null"
            ]
          },
          "objective": {
            "type": [
              "string",
              "null"
            ]
          },
          "constraints": {
            "$ref": "#/definitions/stringSet"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "medium": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "filename": {
            "$ref": "#/definitions/fileName"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "experiments": {
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "experiments": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/experiment"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "type": "object",
    "properties": {
      "version": {
        "type": "string",
        "enum": [
          "0.1"
        ]
      },
      "medium": {
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "definitions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/medium"
            }
          }
        },
        "additionalProperties": false
      },
      "essentiality": {
        "$ref": "#/definitions/experiments"
      },
      "growth": {
        "$ref": "#/definitions/experiments"
      },
      "minimal_growth_rate": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "required": [
      "version"
    ],
    "additionalProperties": false
  },
  "erroneous_json": {
    "version": null,
    "medium": {
      "path": "data/medium/",
      "definitions": {
        "M9": {
          "filename": "media/M9Minimal.csv",
          "label": "M9 Minimal Medium"
        },
        "LB": {
          "filename": "media/LB.tsv",
          "label": "Luria Broth"
        }
      }
    },
    "essentiality": {
      "path": "data/essentiality/",
      "experiments": {
        "gene_knockout_1": {
          "filename": "essentiality/ko1.xlsx",
          "medium": "M9",
          "objective": "biomass",
          "constraints": [
            "EX_glc(e)",
            "EX_o2(e)"
          ],
          "label": "Gene knockout 1"
        },
        "gene_knockout_2": {
          "filename": "essentiality/ko2.tsv",
          "medium": "LB",
          "objective": null,
          "constraints": [],
          "label": "Gene knockout 2"
        }
      }
    },
    "growth": {
      "path": "data/growth/",
      "experiments": {
        "growth_curve_1": {
          "filename": "growth/curve1.csv",
          "medium": "M9",
          "objective": "biomass",
          "constraints": [
            "EX_glc(e)"
          ],
          "label": "Growth curve 1"
        }
      }
    },
    "minimal_growth_rate": 0.05
  },
  "valid_json": {
    "version": "0.1",
    "medium": {
      "path": "data/medium/",
      "definitions": {
        "M9": {
          "filename": "media/M9Minimal.csv",
          "label": "M9 Minimal Medium"
        },
        "LB": {
          "filename": "media/LB.tsv",
          "label": "Luria Broth"
        }
      }
    },
    "essentiality": {
      "path": "data/essentiality/",
      "experiments": {
        "gene_knockout_1": {
          "filename": "essentiality/ko1.xlsx",
          "medium": "M9",
          "objective": "biomass",
          "constraints": [
            "EX_glc(e)",
            "EX_o2(e)"
          ],
          "label": "Gene knockout 1"
        },
        "gene_knockout_2": {
          "filename": "essentiality/ko2.tsv",
          "medium": "LB",
          "objective": null,
          "constraints": [],
          "label": "Gene knockout 2"
        }
      }
    },
    "growth": {
      "path": "data/growth/",
      "experiments": {
        "growth_curve_1": {
          "filename": "growth/curve1.csv",
          "medium": "M9",
          "objective": "biomass",
          "constraints": [
            "EX_glc(e)"
          ],
          "label": "Growth curve 1"
        }
      }
    },
    "minimal_growth_rate": 0.05
  },
  "description": "The configuration is based on version\u202f0.1. All medium files are located under the *data/medium/* directory. Two media are defined: **M9**, whose definition file is *media/M9Minimal.csv* and is labelled \u201cM9 Minimal Medium\u201d, and **LB**, defined by *media/LB.tsv* with the label \u201cLuria Broth\u201d.\n\nEssentiality experiments are stored in *data/essentiality/*. The first knockout experiment, **gene_knockout_1**, uses the file *essentiality/ko1.xlsx*, was performed in the M9 medium, targets the \u201cbiomass\u201d objective, and applies the constraints \u201cEX_glc(e)\u201d and \u201cEX_o2(e)\u201d; it is labelled \u201cGene knockout 1\u201d. The second experiment, **gene_knockout_2**, is described by *essentiality/ko2.tsv*, was carried out in LB, has no specified objective, includes no additional constraints, and carries the label \u201cGene knockout 2\u201d.\n\nGrowth experiments reside in *data/growth/* and consist of a single run, **growth_curve_1**, recorded in *growth/curve1.csv*. This experiment also uses the M9 medium, targets the \u201cbiomass\u201d objective, and imposes the single constraint \u201cEX_glc(e)\u201d; it is labelled \u201cGrowth curve 1\u201d. Finally, the minimal acceptable growth rate for the model is set to **0.05**."
}