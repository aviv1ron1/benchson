        "yesNo": false
      }
    ]
  },
  "valid_json": {
    "availability": "Available weekdays 9am-5pm",
    "essentialRequirements": [
      {
        "evidence": "Completed required training and certifications"
      }
    ],
    "essentialRequirementsMet": true,
    "respondToEmailAddress": "applicant@example.com",
    "niceToHaveRequirements": [
      {
        "yesNo": true,
        "evidence": "Submitted extra portfolio materials"
      },
      {
        "yesNo": false
      }
    ]
  },
  "description": "I am available for user\u2011research sessions on weekdays between 9\u202fam and 5\u202fpm and can be reached at applicant@example.com for any follow\u2011up. I confirm that I meet all essential requirements, having completed the required training and certifications.\n\nIn addition, I have submitted extra portfolio materials to satisfy the first nice\u2011to\u2011have requirement, and I do not meet the second nice\u2011to\u2011have requirement."
}