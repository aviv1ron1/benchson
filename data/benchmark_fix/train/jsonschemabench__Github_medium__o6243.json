{
  "name": "o6243",
  "source": "jsonschemabench",
  "subset": "Github_medium",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "nameTemplate": {
        "title": "Command Name Template",
        "type": "string",
        "minLength": 1
      },
      "payloadTemplate": {
        "title": "Command Payload Template",
        "type": "string"
      },
      "sendToDeviceTags": {
        "title": "Send to Device Tags",
        "type": "array",
        "minItems": 1,
        "items": {
          "title": "Device Tag Pair",
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "minLength": 1
        }
      },
      "sendToDeviceIds": {
        "title": "Send to Device IDs",
        "type": "array",
        "minItems": 1,
        "items": {
          "title": "Device ID",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allOf": [
      {
        "required": [
          "nameTemplate"
        ]
      },
      {
        "anyOf": [
          {
            "required": [
              "sendToDeviceIds"
            ]
          },
          {
            "required": [
              "sendToDeviceTags"
            ]
          }
        ]
      }
    ]
  },
  "erroneous_json": {
    "nameTemplate": "restart-{deviceId}",
    "payloadTemplate": "{\"action\":\"restart\"}",
    "sendToDeviceTags": [
      "not-an-object",
      {
        "key": "type",
        "value": "sensor"
      }
    ],
    "sendToDeviceIds": [
      "device-123",
      "device-456"
    ]
  },
  "valid_json": {
    "nameTemplate": "restart-{deviceId}",
    "payloadTemplate": "{\"action\":\"restart\"}",
    "sendToDeviceTags": [
      {
        "key": "region",
        "value": "us-east"
      },
      {
        "key": "type",
        "value": "sensor"
      }
    ],
    "sendToDeviceIds": [
      "device-123",
      "device-456"
    ]
  },
  "description": "We are preparing to dispatch a restart command across our fleet. The command name follows the template **restart\u2011{deviceId}**, and each invocation will carry the payload `{\"action\":\"restart\"}`.  \n\nThe operation should target any device tagged with **region\u202f=\u202fus\u2011east** and **type\u202f=\u202fsensor**, as well as the specific units identified by IDs **device\u2011123** and **device\u2011456**. Please ensure both the tagged groups and the listed IDs receive the command when it is rolled out."
}