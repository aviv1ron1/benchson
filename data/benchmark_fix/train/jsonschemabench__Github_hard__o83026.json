        "pbj": {
          "type": "message-ref",
          "rule": "single"
        }
      },
      "updated_at": {
        "type": "string",
        "pattern": "^[1-9]{1}[0-9]{12,15}$",
        "pbj": {
          "type": "microtime",
          "rule": "single",
          "useTypeDefault": false
        }
      },
      "updater_ref": {
        "type": "object",
