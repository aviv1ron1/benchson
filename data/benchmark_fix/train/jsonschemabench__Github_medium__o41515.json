{
  "name": "o41515",
  "source": "jsonschemabench",
  "subset": "Github_medium",
  "schema": {
    "title": "Invocation manifest for CNI-DCM-CONVERT - DICOM conversion tool",
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "config": {
        "type": "object",
        "properties": {
          "convert_montage": {
            "default": true,
            "type": "boolean"
          },
          "convert_nifti": {
            "default": true,
            "type": "boolean"
          },
          "convert_png": {
            "default": false,
            "type": "boolean"
          },
          "convert_mux": {
            "default": false,
            "type": "boolean"
          },
          "output_name": {
            "type": "string"
          }
        },
        "required": [
          "convert_montage",
          "convert_nifti",
          "convert_png",
          "convert_mux"
        ]
      },
      "inputs": {
        "type": "object",
        "properties": {
          "dicom": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "dicom"
                ]
              }
            }
          }
        },
        "required": [
          "dicom"
        ]
      }
    },
    "required": [
      "config",
      "inputs"
    ]
  },
  "erroneous_json": {
    "config": {
      "convert_nifti": true,
      "convert_png": false,
      "convert_mux": false,
      "output_name": "study_001_output"
    },
    "inputs": {
      "dicom": {
        "type": "dicom"
      }
    }
  },
  "valid_json": {
    "config": {
      "convert_montage": true,
      "convert_nifti": true,
      "convert_png": false,
      "convert_mux": false,
      "output_name": "study_001_output"
    },
    "inputs": {
      "dicom": {
        "type": "dicom"
      }
    }
  },
  "description": "The upcoming conversion run will process a DICOM series supplied as the input dataset. The source is identified as a DICOM type, confirming that the job will read standard medical imaging files.\n\nFor this job the configuration enables both montage and NIfTI generation, while deliberately skipping PNG and MUX outputs. All resulting files will be written using the base name **study_001_output**, so you can expect products such as\u202fstudy_001_output_montage.* and\u202fstudy_001_output.nii*."
}