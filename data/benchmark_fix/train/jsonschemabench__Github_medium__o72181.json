{
  "name": "o72181",
  "source": "jsonschemabench",
  "subset": "Github_medium",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "HTML Widget Template Schema",
    "description": "Defines a web-component based widget template that uses vanilla HTML.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "meta",
      "htmlTemplate"
    ],
    "properties": {
      "meta": {
        "type": "object",
        "title": "Template Meta",
        "additionalProperties": false,
        "required": [
          "dependencies",
          "plugins"
        ],
        "properties": {
          "dependencies": {
            "type": "array",
            "description": "A list of NPM resources to load into the widget",
            "items": {
              "$ref": "#/definitions/npmDependency"
            }
          },
          "plugins": {
            "type": "array",
            "description": "A list of component editors used in editing the widget",
            "items": {
              "$ref": "#/definitions/npmDependency"
            }
          }
        }
      },
      "htmlTemplate": {
        "type": "string",
        "title": "HTML Template",
        "description": "Raw HTML content that can use web components."
      }
    },
    "definitions": {
      "npmDependency": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string",
            "description": "An NPM package name or scoped package"
          },
          "version": {
            "type": "string",
            "description": "An NPM version string, such as Patch releases: 1.0 or 1.0.x or ~1.0.4 Minor releases: 1 or 1.x or ^1.0.4 Major releases: * or x",
            "default": "latest"
          },
          "filePath": {
            "type": "string",
            "description": "The path to a resource in the specified package",
            "default": ""
          }
        },
        "required": [
          "version",
          "package"
        ]
      }
    }
  },
  "erroneous_json": {
    "meta": {
      "dependencies": [
        {
          "package": "lodash",
          "version": "^4.17.21"
        },
        {
          "package": "@material/web",
          "version": "1.0.0",
          "filePath": "components/button.js"
        }
      ]
    },
    "htmlTemplate": "<!-- Sample widget using web components -->\n<div class=\"widget-container\">\n  <my-card title=\"Dashboard\">\n    <my-chart data-url=\"/api/metrics\"></my-chart>\n  </my-card>\n  <my-list items='[\"Item 1\",\"Item 2\",\"Item 3\"]'></my-list>\n</div>"
  },
  "valid_json": {
    "meta": {
      "dependencies": [
        {
          "package": "lodash",
          "version": "^4.17.21"
        },
        {
          "package": "@material/web",
          "version": "1.0.0",
          "filePath": "components/button.js"
        }
      ],
      "plugins": [
        {
          "package": "ckeditor5-build-classic",
          "version": "~35.0.1"
        },
        {
          "package": "gridstack",
          "version": "4.x",
          "filePath": "dist/gridstack.all.js"
        }
      ]
    },
    "htmlTemplate": "<!-- Sample widget using web components -->\n<div class=\"widget-container\">\n  <my-card title=\"Dashboard\">\n    <my-chart data-url=\"/api/metrics\"></my-chart>\n  </my-card>\n  <my-list items='[\"Item 1\",\"Item 2\",\"Item 3\"]'></my-list>\n</div>"
  },
  "description": "Hello team,\n\nFor the new dashboard widget we\u2019ve assembled the following NPM resources: the utility library **lodash** at version **^4.17.21**, and the Material Web component set **@material/web** version **1.0.0**, loading the button module from\u202f`components/button.js`. In terms of editor plugins, we\u2019re using **ckeditor5\u2011build\u2011classic** at version **~35.0.1**, together with **gridstack** version **4.x**, which includes the full script from\u202f`dist/gridstack.all.js`.\n\nBelow is the raw HTML that makes up the widget layout. It employs our custom web components to render a card, a chart, and a list:\n\n```html\n<!-- Sample widget using web components -->\n<div class=\"widget-container\">\n  <my-card title=\"Dashboard\">\n    <my-chart data-url=\"/api/metrics\"></my-chart>\n  </my-card>\n  <my-list items='[\"Item 1\",\"Item 2\",\"Item 3\"]'></my-list>\n</div>\n```"
}