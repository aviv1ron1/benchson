{
  "name": "o27362",
  "source": "jsonschemabench",
  "subset": "Github_medium",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "KVM manifest",
    "type": "object",
    "properties": {
      "bootstrapper": {
        "type": "object",
        "properties": {
          "virtio": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "system": {
        "type": "object",
        "properties": {
          "bootloader": {
            "type": "string",
            "enum": [
              "grub",
              "extlinux"
            ]
          }
        }
      },
      "volume": {
        "type": "object",
        "properties": {
          "backing": {
            "type": "string",
            "enum": [
              "raw"
            ]
          },
          "partitions": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "msdos",
                  "gpt"
                ]
              }
            }
          }
        },
        "required": [
          "backing"
        ]
      }
    }
  },
  "erroneous_json": {
    "bootstrapper": null,
    "system": {
      "bootloader": "grub"
    },
    "volume": {
      "backing": "raw",
      "partitions": {
        "type": "gpt"
      }
    }
  },
  "valid_json": {
    "bootstrapper": {
      "virtio": [
        "virtio-net",
        "virtio-blk"
      ]
    },
    "system": {
      "bootloader": "grub"
    },
    "volume": {
      "backing": "raw",
      "partitions": {
        "type": "gpt"
      }
    }
  },
  "description": "The new KVM instance will be bootstrapped with the VirtIO drivers\u202f\u2014\u202fspecifically the \u201cvirtio\u2011net\u201d and \u201cvirtio\u2011blk\u201d modules. For the operating system we\u2019ll employ GRUB as the bootloader.  \n\nThe virtual disk will use a raw backing file, and its layout will follow a GPT partition scheme."
}