{
  "name": "behat",
  "source": "schemas",
  "subset": null,
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://json.schemastore.org/behat.json",
    "additionalProperties": {
      "$ref": "#/definitions/profile",
      "title": "Profile name"
    },
    "definitions": {
      "profile": {
        "title": "Profile",
        "type": "object",
        "properties": {
          "autoload": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "formatters": {
            "title": "How to format tests output",
            "default": "pretty",
            "type": "object",
            "properties": {
              "pretty": {
                "title": "Prints the feature as is",
                "type": "boolean"
              },
              "progress": {
                "title": "Prints one character per step",
                "type": "boolean"
              },
              "junit": {
                "title": "Outputs the failures in JUnit compatible files.",
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "suites": {
            "title": "Test suites",
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/suite"
            }
          },
          "extensions": {
            "title": "Behat extensions",
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      },
      "suite": {
        "title": "Test suite",
        "type": "object",
        "properties": {
          "paths": {
            "title": "Paths to execute",
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "contexts": {
            "title": "Suite contexts",
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            },
            "uniqueItems": true
          },
          "filters": {
            "title": "Suite filters",
            "type": "object",
            "properties": {
              "tags": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "properties": {
      "default": {
        "$ref": "#/definitions/profile",
        "title": "Default profile"
      },
      "imports": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "title": "JSON schema for Behat configuration files",
    "type": "object"
  },
  "erroneous_json": {
    "default": {
      "autoload": {
        "App\\": "src/"
      },
      "formatters": {
        "pretty": true,
        "progress": false,
        "junit": false
      },
      "suites": {
        "default": {
          "paths": [
            "features/"
          ],
          "contexts": [
            "FeatureContext",
            {
              "class": "ApiContext",
              "arguments": []
            }
          ],
          "filters": {
            "tags": "~@skip",
            "role": "admin"
          }
        },
        "api": {
          "paths": [
            "features/api"
          ],
          "contexts": [
            "ApiFeatureContext"
          ],
          "filters": {
            "tags": "@api"
          }
        }
      },
      "extensions": {
        "Behat\\MinkExtension": {
          "default_session": "goutte",
          "base_url": "http://localhost"
        }
      }
    },
    "ci": {
      "autoload": {
        "Tests\\": "tests/"
      },
      "formatters": {
        "pretty": false,
        "progress": true,
        "junit": true
      },
      "suites": {
        "default": {
          "paths": [
            "features/"
          ],
          "contexts": [
            "FeatureContext"
          ],
          "filters": {
            "tags": "@smoke"
          }
        }
      },
      "extensions": {
        "Behat\\Symfony2Extension": {}
      }
    },
    "imports": [
      99999
    ]
  },
  "valid_json": {
    "default": {
      "autoload": {
        "App\\": "src/"
      },
      "formatters": {
        "pretty": true,
        "progress": false,
        "junit": false
      },
      "suites": {
        "default": {
          "paths": [
            "features/"
          ],
          "contexts": [
            "FeatureContext",
            {
              "class": "ApiContext",
              "arguments": []
            }
          ],
          "filters": {
            "tags": "~@skip",
            "role": "admin"
          }
        },
        "api": {
          "paths": [
            "features/api"
          ],
          "contexts": [
            "ApiFeatureContext"
          ],
          "filters": {
            "tags": "@api"
          }
        }
      },
      "extensions": {
        "Behat\\MinkExtension": {
          "default_session": "goutte",
          "base_url": "http://localhost"
        }
      }
    },
    "ci": {
      "autoload": {
        "Tests\\": "tests/"
      },
      "formatters": {
        "pretty": false,
        "progress": true,
        "junit": true
      },
      "suites": {
        "default": {
          "paths": [
            "features/"
          ],
          "contexts": [
            "FeatureContext"
          ],
          "filters": {
            "tags": "@smoke"
          }
        }
      },
      "extensions": {
        "Behat\\Symfony2Extension": {}
      }
    },
    "imports": [
      "vendor/behat/behat/config.yml"
    ]
  },
  "description": "Here is the current Behat configuration for the project. The default profile autoloads the \u201cApp\\\u201d namespace from the **src/** directory and uses the \u201cpretty\u201d formatter (enabled), while the \u201cprogress\u201d and \u201cjunit\u201d formatters are disabled. Two test suites are defined: the **default** suite runs all features under **features/**, includes the `FeatureContext` class and an `ApiContext` (instantiated with no arguments), and applies the tag filter \u201c~@skip\u201d together with the role filter \u201cadmin\u201d. The **api** suite points to **features/api**, uses only the `ApiFeatureContext`, and filters scenarios tagged \u201c@api\u201d. For this profile the Mink extension is activated with a default Goutte session and a base URL of **http://localhost**.\n\nA separate **ci** profile is also set up for continuous\u2011integration runs. It autoloads the \u201cTests\\\u201d namespace from **tests/**, switches the output to the \u201cprogress\u201d formatter (enabled) and the \u201cjunit\u201d formatter (enabled), while turning off the \u201cpretty\u201d formatter. Its only suite, also called **default**, runs the same **features/** path, uses the `FeatureContext`, and limits execution to scenarios tagged \u201c@smoke\u201d. The CI profile loads the Symfony2 extension without any additional options. Finally, the configuration imports the shared Behat settings from **vendor/behat/behat/config.yml**."
}