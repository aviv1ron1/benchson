            },
            "error-count": {
              "type": "integer",
              "title": "Error count",
              "description": "Number of errors found.",
              "minimum": 0
            },
            "row-count": {
              "type": "integer",
              "title": "Row count",
              "description": "Number of rows validated.",
              "minimum": 0
            },
            "source": {
              "type": [
                "string",
                "array"
              ],
              "title": "Source",
              "description": "Path or URI where this table was loaded from."
            },
            "headers": {
              "type": "array",
              "title": "Headers",
              "description": "List of table's headers.",
              "items": {
                "type": "string"
              }
            },
            "scheme": {
              "type": "string",
              "title": "Scheme",
