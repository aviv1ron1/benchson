  "description": "We have deployed a Server Management gateway called **myGateway** in the **westus2** region. The gateway is registered under the type **Microsoft.ServerManagement/gateways** and uses the **2015-07-01-preview** API version. No additional configuration properties are required for this gateway at the moment.\n\nIn the same region we have also provisioned a Server Management node named **myNode**. The node is defined with the type **Microsoft.ServerManagement/nodes** and likewise uses the **2015-07-01-preview** API version. It is linked to the gateway via the ARM resource identifier **/subscriptions/12345/resourceGroups/rg1/providers/Microsoft.ServerManagement/gateways/myGateway**, and it will connect using the name **node01.example.com**.",
  "reference_json": {
    "resourceDefinitions.gateway": {
      "apiVersion": "2015-07-01-preview",
      "type": "Microsoft.ServerManagement/gateways",
      "location": "westus2",
      "name": "myGateway",
      "properties": {}
    },
    "resourceDefinitions.node": {
      "apiVersion": "2015-07-01-preview",
      "type": "Microsoft.ServerManagement/nodes",
      "location": "westus2",
      "name": "myNode",
      "properties": {
        "gatewayId": "/subscriptions/12345/resourceGroups/rg1/providers/Microsoft.ServerManagement/gateways/myGateway",
        "connectionName": "node01.example.com"
      }
    }
  }
