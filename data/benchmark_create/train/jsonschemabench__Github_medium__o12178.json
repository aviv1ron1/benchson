  "description": "Our OAuth\u202f2.0 setup defines two grant types. For the **implicit grant**, the user is redirected to the login endpoint at\u202f`https://example.com/oauth/authorize`, and the service will return the access token in a parameter called\u202f`access_token`.\n\nFor the **authorization\u2011code grant**, the token\u2011exchange step uses the token endpoint `https://example.com/oauth/token`, which also supplies the token under the name\u202f`access_token`. The initial request to obtain an authorization code is sent to `https://example.com/oauth/token-request`; when posting this request the client identifier must be placed in a field named\u202f`client_id` and the client secret in a field named\u202f`client_secret`.",
  "reference_json": {
    "implicit": {
      "loginEndpoint": {
        "url": "https://example.com/oauth/authorize"
      },
      "tokenName": "access_token"
    },
    "authorization_code": {
      "tokenEndpoint": {
        "url": "https://example.com/oauth/token",
        "tokenName": "access_token"
      },
      "tokenRequestEndpoint": {
        "url": "https://example.com/oauth/token-request",
        "clientIdName": "client_id",
        "clientSecretName": "client_secret"
      }
    }
  }
