            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "tokenEndpoint": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "tokenName": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
