  "description": "The structural preprocessing will be executed for subject **sub\u2011001** using the default MSMSulc registration. The brain volume is assumed to be 150\u202fmm in size and will be matched to a 0.8\u202fmm template; distortion correction will be applied along the z\u2011axis. Automatic saving on error is disabled, and the pipeline will run in normal mode (dry\u2011run set to false). An ASEG CSV report will be generated as part of the output.\n\nAuthentication is provided via the API key **abcd1234efgh5678**. The required imaging inputs are the T1\u2011weighted NIfTI file at */data/sub-001_T1w.nii.gz* and the T2\u2011weighted NIfTI file at */data/sub-001_T2w.nii.gz*. A FreeSurfer license file located at */licenses/freesurfer.txt* is supplied. Gradient\u2011coefficient information is given in the JSON file *gradcoeff.json*. Additional spin\u2011echo and Siemens GRE data are included: the positive spin\u2011echo NIfTI at */data/sub-001_SEpos.nii.gz*, the negative spin\u2011echo NIfTI at */data/sub-001_SEneg.nii.gz*, the GRE magnitude NIfTI at */data/sub-001_GRE_mag.nii.gz*, and the GRE phase NIfTI at */data/sub-001_GRE_phase.nii.gz*.",
  "reference_json": {
    "config": {
      "save-on-error": false,
      "Subject": "sub-001",
      "RegName": "MSMSulc",
      "BrainSize": 150,
      "TemplateSize": "0.8mm",
      "StructuralUnwarpDirection": "z",
      "aseg_csv": true,
      "Dry-Run": false
    },
    "inputs": {
      "api-key": {
        "key": "abcd1234efgh5678"
      },
      "T1": {
        "type": "nifti",
        "path": "/data/sub-001_T1w.nii.gz"
      },
      "T2": {
        "type": "nifti",
        "path": "/data/sub-001_T2w.nii.gz"
      },
      "FreeSurferLicense": {
        "license_file": "/licenses/freesurfer.txt"
      },
      "GradientCoeff": {
        "type": "json",
        "file": "gradcoeff.json"
      },
      "SpinEchoPositive": {
        "type": "nifti",
        "path": "/data/sub-001_SEpos.nii.gz"
      },
      "SpinEchoNegative": {
        "type": "nifti",
        "path": "/data/sub-001_SEneg.nii.gz"
      },
      "SiemensGREMagnitude": {
        "type": "nifti",
        "path": "/data/sub-001_GRE_mag.nii.gz"
      },
      "SiemensGREPhase": {
        "type": "nifti",
        "path": "/data/sub-001_GRE_phase.nii.gz"
      }
    }
  }
