            "type": "object",
            "properties": {}
          },
          "GradientCoeff": {
            "type": "object",
            "properties": {}
          },
          "SpinEchoPositive": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "nifti"
                ]
              }
            }
          },
          "SpinEchoNegative": {
