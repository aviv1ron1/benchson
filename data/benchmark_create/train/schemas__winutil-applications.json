{
  "name": "winutil-applications",
  "source": "schemas",
  "subset": null,
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://json.schemastore.org/winutil-applications.json",
    "definitions": {
      "string-property": {
        "type": "string",
        "minLength": 1,
        "pattern": "[^ ]"
      }
    },
    "title": "applications",
    "description": "Applications\nhttps://github.com/ChrisTitusTech/winutil/blob/main/config/applications.json",
    "type": "object",
    "minProperties": 1,
    "patternProperties": {
      ".": {
        "title": "application",
        "description": "An application\nhttps://github.com/ChrisTitusTech/winutil/blob/main/config/applications.json",
        "type": "object",
        "required": [
          "description",
          "category",
          "link",
          "choco",
          "winget",
          "content"
        ],
        "properties": {
          "description": {
            "$ref": "#/definitions/string-property",
            "title": "description",
            "description": "A description of an application\nhttps://github.com/ChrisTitusTech/winutil/blob/main/config/applications.json"
          },
          "category": {
            "title": "category",
            "description": "A category of an application\nhttps://github.com/ChrisTitusTech/winutil/blob/main/config/applications.json",
            "type": "string",
            "enum": [
              "Browsers",
              "Communications",
              "Development",
              "Document",
              "Games",
              "Microsoft Tools",
              "Multimedia Tools",
              "Pro Tools",
              "Utilities"
            ]
          },
          "link": {
            "title": "link",
            "description": "A link of an application\nhttps://github.com/ChrisTitusTech/winutil/blob/main/config/applications.json",
            "type": "string",
            "minLength": 1,
            "pattern": "^https?://",
            "format": "uri"
          },
          "choco": {
            "$ref": "#/definitions/string-property",
            "title": "choco",
            "description": "A Chocolatey package name of an application\nhttps://github.com/ChrisTitusTech/winutil/blob/main/config/applications.json"
          },
          "winget": {
            "$ref": "#/definitions/string-property",
            "title": "winget",
            "description": "A WinGet package name of an application\nhttps://github.com/ChrisTitusTech/winutil/blob/main/config/applications.json"
          },
          "content": {
            "$ref": "#/definitions/string-property",
            "title": "content",
            "description": "A label of an application\nhttps://github.com/ChrisTitusTech/winutil/blob/main/config/applications.json"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "description": "Subject: Recommendation \u2013\u202fMyApp (Utilities)\n\nHi everyone,\n\nI'd like to bring MyApp to your attention. It\u2019s a lightweight utility (category: **Utilities**) that serves a single purpose, described simply as **\u201cD.\u201d** You can find more information and download it from its homepage at https://example.com. For automated deployment we can use the Chocolatey package **c** or the WinGet identifier **w**, whichever fits our workflow best. Internally we\u2019ll label this entry as **C** for quick reference.\n\nLet me know if you\u2019d like me to add it to our standard toolset.",
  "reference_json": {
    "MyApp": {
      "description": "D",
      "category": "Utilities",
      "link": "https://example.com",
      "choco": "c",
      "winget": "w",
      "content": "C"
    }
  }
}