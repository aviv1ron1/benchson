{
  "name": "o27351",
  "source": "jsonschemabench",
  "subset": "Github_easy",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "cloud-init plugin manifest",
    "type": "object",
    "properties": {
      "system": {
        "type": "object",
        "properties": {
          "release": {
            "type": "string",
            "enum": [
              "wheezy",
              "stable",
              "jessie",
              "testing",
              "sid",
              "unstable"
            ]
          }
        }
      },
      "plugins": {
        "type": "object",
        "properties": {
          "cloud_init": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string"
              },
              "disable_modules": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "_uniqueItems": true
              },
              "metadata_sources": {
                "type": "string"
              }
            },
            "required": [
              "username"
            ]
          },
          "packages": {
            "type": "object"
          }
        },
        "required": [
          "cloud_init"
        ]
      }
    }
  },
  "description": "The current system is running the **stable** release. For cloud\u2011init, the configuration assigns the user **cloudadmin**, disables the **network** and **ssh** modules, and sets **EC2** as the sole metadata source. No extra packages have been added to the manifest.",
  "reference_json": {
    "system": {
      "release": "stable"
    },
    "plugins": {
      "cloud_init": {
        "username": "cloudadmin",
        "disable_modules": [
          "network",
          "ssh"
        ],
        "metadata_sources": "ec2"
      },
      "packages": {}
    }
  }
}