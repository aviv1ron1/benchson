          }
        },
        "additionalProperties": false
      },
      "inputSet": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "include": {
                "$ref": "#/definitions/_listOfGlobs"
              },
              "exclude": {
                "$ref": "#/definitions/_listOfGlobs"
              }
            },
            "additionalProperties": false
          },
          {
            "$comment": "Use List<String> directly, inferred to mean include.",
            "$ref": "#/definitions/_listOfGlobs"
          }
        ]
      },
      "targetBuilderConfig": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
