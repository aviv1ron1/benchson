        "type": "object",
        "properties": {
          "builder_factories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "import": {
            "type": "string"
          },
          "build_extensions": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "auto_apply": {
            "$ref": "#/definitions/autoApply",
            "default": "none"
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runs_before": {
