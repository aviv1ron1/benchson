          },
          "options": {
            "$ref": "#/definitions/builderOptions"
          },
          "dev_options": {
            "$ref": "#/definitions/builderOptions"
          },
          "release_options": {
            "$ref": "#/definitions/builderOptions"
          }
        },
        "additionalProperties": false
      },
      "targetBuilderConfigDefaults": {
        "type": "object",
        "properties": {
          "generate_for": {
            "$ref": "#/definitions/inputSet"
          },
          "options": {
            "$ref": "#/definitions/builderOptions"
          },
          "dev_options": {
            "$ref": "#/definitions/builderOptions"
          },
          "release_options": {
            "$ref": "#/definitions/builderOptions"
          }
        },
        "additionalProperties": false
      },
      "globalBuilderOptions": {
        "type": "object",
        "properties": {
          "options": {
            "$ref": "#/definitions/builderOptions"
          },
          "dev_options": {
            "$ref": "#/definitions/builderOptions"
          },
          "release_options": {
            "$ref": "#/definitions/builderOptions"
          },
          "runs_before": {
            "$ref": "#/definitions/runsBefore"
          }
        },
        "additionalProperties": false
      },
      "builderOptions": {
        "type": "object",
        "title": "Options to apply to a builder",
        "description": "An arbitrary Map<String, dynamic> of configuration options exposed by the individual builders. See the documentation for the builder you are configuring for guidance.",
        "additionalProperties": true
      },
      "autoApply": {
        "type": "string",
        "description": "On which packages the builder is applied by default",
        "enum": [
          "none",
          "dependents",
          "all_packages",
          "root_package"
        ]
      },
      "buildTo": {
        "type": "string",
        "description": "Whether the outputs should be stored in a hidden cache or in the source directory.",
        "enum": [
          "cache",
          "source"
        ]
      },
      "targetKey": {
        "type": "string",
        "title": "An identifier for a target",
        "description": "A target key has two parts, a package and a name. They are separated by a colon.",
        "pattern": "^(?:\\w+:)?\\w+|\\$default$"
      },
      "builderKey": {
        "type": "string",
        "title": "An identifier for a builder",
        "description": "To construct a key, you join the package name and the builder name with a colon.",
        "pattern": "^(?:\\w*:)?\\w+$"
      },
      "runsBefore": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/builderKey"
        }
      }
    },
    "description": "Configuration for Dart's build system",
    "title": "build.yaml files"
  },
  "description": "The project\u2019s build configuration defines a single default target that applies builders automatically. This target uses the builder identified as **my_pkg:my_builder**, which is enabled and set to generate code for every Dart file under\u202f`lib/**.dart` while explicitly skipping anything in the `test/**` directory. The builder receives the options `optimize: true` and `mode: \"debug\"`. The target also declares a dependency on **my_pkg:other_target** and restricts its source files to the `lib/**` and `web/**` globs, excluding any files matching `lib/generated/**`.\n\nTwo builders are registered. **my_pkg:my_builder** is created by the factory `myBuilder` from `package:my_pkg/builder.dart`; it transforms a `.dart` file into a `.g.dart` file, applies automatically to dependents, requires the input pattern `lib/**.dart`, runs before and applies the builder **another_pkg:another_builder**, is not optional, and writes its output directly into the source tree. Its defaults broaden the generation scope to all `lib/**` files and prepend a header comment `// GENERATED CODE - DO NOT MODIFY BY HAND`. The second builder, **another_pkg:another_builder**, comes from `package:another_pkg/builder.dart`, converts `.g.dart` files into `.min.dart` files, applies to all packages, and stores its results in the hidden cache.\n\nA post\u2011process builder named **my_pkg:post_builder** (factory `postBuilder` from `package:my_pkg/post_builder.dart`) processes files with the `.g.dart` extension and, by default, enables the option `minify: true`. Global options for **my_pkg:my_builder** set a `globalFlag: true` and ensure it runs before **another_pkg:another_builder**. Finally, the configuration makes the public assets under `web/assets/**` and `lib/assets/**` available to other packages.",
  "reference_json": {
    "targets": {
      "$default": {
        "auto_apply_builders": true,
        "builders": {
          "my_pkg:my_builder": {
            "enabled": true,
            "generate_for": {
              "include": [
                "lib/**.dart"
              ],
              "exclude": [
                "test/**"
              ]
            },
            "options": {
              "optimize": true,
              "mode": "debug"
            }
          }
        },
        "dependencies": [
          "my_pkg:other_target"
        ],
        "sources": {
          "include": [
            "lib/**",
            "web/**"
          ],
          "exclude": [
            "lib/generated/**"
          ]
        }
      }
    },
    "builders": {
      "my_pkg:my_builder": {
        "builder_factories": [
          "myBuilder"
        ],
        "import": "package:my_pkg/builder.dart",
        "build_extensions": {
          ".dart": [
            ".g.dart"
          ]
        },
        "auto_apply": "dependents",
        "required_inputs": [
          "lib/**.dart"
        ],
        "runs_before": [
          "another_pkg:another_builder"
        ],
        "applies_builders": [
          "another_pkg:another_builder"
        ],
        "is_optional": false,
        "build_to": "source",
        "defaults": {
          "generate_for": {
            "include": [
              "lib/**"
            ]
          },
          "options": {
            "header": "// GENERATED CODE - DO NOT MODIFY BY HAND"
          }
        }
      },
      "another_pkg:another_builder": {
        "builder_factories": [
          "anotherBuilder"
        ],
        "import": "package:another_pkg/builder.dart",
        "build_extensions": {
          ".g.dart": [
            ".min.dart"
          ]
        },
        "auto_apply": "all_packages",
        "build_to": "cache"
      }
    },
    "post_process_builders": {
      "my_pkg:post_builder": {
        "builder_factory": "postBuilder",
        "import": "package:my_pkg/post_builder.dart",
        "input_extensions": [
          ".g.dart"
        ],
        "defaults": {
          "options": {
            "minify": true
          }
        }
      }
    },
    "global_options": {
      "my_pkg:my_builder": {
        "options": {
          "globalFlag": true
        },
        "runs_before": [
          "another_pkg:another_builder"
        ]
      }
    },
    "additional_public_assets": [
      "web/assets/**",
      "lib/assets/**"
    ]
  }
}