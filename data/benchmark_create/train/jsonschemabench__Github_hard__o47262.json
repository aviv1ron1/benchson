  "schema": {
    "$schema": "http://json-schema.org/draft-06/schema#",
    "title": "IGF metadata validation schema",
    "description": "Schema for validation of metadata input file",
    "type": "array",
    "version": "1.0.1",
    "minItems": 1,
    "_uniqueItems": true,
    "items": {
      "type": "object",
      "properties": {
        "project_igf_id": {
          "type": "string",
          "pattern": "^IGF[a-zA-Z0-9-_]+$",
          "maxLength": 50
        },
        "name": {
          "type": "string",
          "pattern": "^\\w+\\s\\w+\\s?\\w+?$"
        },
        "hpc_username": {
          "type": "string",
          "pattern": "^\\S+$|^$"
        },
        "username": {
