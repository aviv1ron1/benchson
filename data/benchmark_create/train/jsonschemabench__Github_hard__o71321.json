{
  "name": "o71321",
  "source": "jsonschemabench",
  "subset": "Github_hard",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "addons": {
        "description": "Additional charater/sequences to add",
        "type": "array",
        "items": {
          "type": "object",
          "oneOf": [
            {
              "description": "A single character/sequence",
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required": [
                "symbol"
              ]
            },
            {
              "description": "A group of characters/sequences",
              "symbols": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "description": "Padding",
                      "type": "null"
                    },
                    {
                      "description": "A single symbol",
                      "type": "string"
                    },
                    {
                      "description": "A group of alternate symbols",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "A range of characters (inclusive)",
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string"
                        },
                        "to": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "symbols"
              ]
            }
          ],
          "properties": {
            "group": {
              "type": "string"
            },
            "subGroup": {
              "type": "string"
            }
          },
          "required": [
            "group",
            "subGroup"
          ]
        }
      },
      "iconFallback": {
        "type": "array",
        "items": {
          "properties": {
            "windows": {
              "description": "Windows version in which the elements are supported",
              "type": "string",
              "default": "10"
            },
            "version": {
              "description": "Use fallback icon if unicode version >= number",
              "type": "number"
            },
            "emojiVersion": {
              "description": "Use fallback icon if emoji version >= number",
              "type": "number"
            },
            "characters": {
              "description": "Use fallback icon for a given text range",
              "type": "array",
              "items": {
                "properties": {
                  "from": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "to": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "required": [
                  "from",
                  "to"
                ]
              }
            },
            "sequences": {
              "description": "Use fallback icon for given sequences or characters",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "windows"
          ]
        }
      },
      "forceVersion": {
        "description": "Force a version for remote resources. Include trailing zeros.",
        "type": "object",
        "properties": {
          "cldr": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "ucd": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "keyboards": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "symbol": {
              "type": "string"
            },
            "content": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "group": {
                    "type": "string"
                  },
                  "subGroup": {
                    "type": "string"
                  }
                },
                "required": [
                  "group",
                  "subGroup"
                ]
              }
            }
          },
          "required": [
            "name",
            "symbol",
            "content"
          ]
        }
      },
      "nogroup": {
        "description": "Disable automatic grouping",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "keymaps": {
        "description": "Additional keymaps",
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "name",
            "keys"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "Display name",
              "type": "string"
            },
            "keys": {
              "description": "Use scancode as index",
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "keyboards"
    ]
  },
  "description": "The configuration adds two custom symbols: the exclamation mark \u201c!\u201d (group\u202f=\u202fpunctuation, sub\u2011group\u202f=\u202fbasic) is labeled **Exclamation** and can be searched with the keywords \u201cbang\u201d or \u201cexclaim\u201d. The second addon belongs to the arrows group (sub\u2011group\u202f=\u202fdirectional) and defines a mixed set of symbols \u2013 a consecutive range from the left arrow (\u2190) to the down arrow (\u2193), a padding slot, the double\u2011headed arrow (\u2194), and an alternate collection consisting of the four cardinal arrows \u2190, \u2192, \u2191, \u2193.  \n\nFor legacy support we provide two icon\u2011fallback rules. On Windows\u202f10 the fallback activates when the Unicode version is 13 or higher, or when the Emoji version reaches 14.0; it also applies to any character in the range U+1F600\u2013U+1F64F and to the sequences \u201c<3\u201d and \u201c\\u2764\\uFE0F\u201d. A second rule covers Windows\u202f8.1 systems, falling back when the Unicode version is at least 12.  \n\nVersioning is locked to CLDR\u202f45.0.0, Emoji\u202f15.0 and UCD\u202f15.0.0. The keyboard layouts include a standard QWERTY (symbol \u2328) containing the \u201cletters\u202f\u2192\u202flatin\u201d and \u201cnumbers\u202f\u2192\u202fdigits\u201d groups, and a Dvorak layout (symbol \u2328\ufe0f) with \u201cletters\u202f\u2192\u202fdvorak\u201d plus \u201cpunctuation\u202f\u2192\u202fbasic\u201d. Automatic grouping is disabled for the \u201cemoji\u201d and \u201csymbols\u201d categories. Finally, two custom keymaps are defined: **Gaming Layout** maps scancodes 87,\u202f65,\u202f83 and\u202f68 to W, A, S and D respectively; **Numeric Pad** maps scancodes 96\u201199 to the digits 0\u20113.",
  "reference_json": {
    "addons": [
      {
        "group": "punctuation",
        "subGroup": "basic",
        "symbol": "!",
        "name": "Exclamation",
        "keywords": [
          "bang",
          "exclaim"
        ]
      },
      {
        "group": "arrows",
        "subGroup": "directional",
        "symbols": [
          {
            "from": "\u2190",
            "to": "\u2193"
          },
          null,
          "\u2194",
          [
            "\u2190",
            "\u2192",
            "\u2191",
            "\u2193"
          ]
        ]
      }
    ],
    "iconFallback": [
      {
        "windows": "10",
        "version": 13,
        "emojiVersion": 14.0,
        "characters": [
          {
            "from": "U+1F600",
            "to": "U+1F64F"
          }
        ],
        "sequences": [
          "<3",
          "\\u2764\\uFE0F"
        ]
      },
      {
        "windows": "8.1",
        "version": 12
      }
    ],
    "forceVersion": {
      "cldr": "45.0.0",
      "emoji": "15.0",
      "ucd": "15.0.0"
    },
    "keyboards": [
      {
        "name": "Standard QWERTY",
        "symbol": "\u2328",
        "content": [
          {
            "group": "letters",
            "subGroup": "latin"
          },
          {
            "group": "numbers",
            "subGroup": "digits"
          }
        ]
      },
      {
        "name": "Dvorak",
        "symbol": "\u2328\ufe0f",
        "content": [
          {
            "group": "letters",
            "subGroup": "dvorak"
          },
          {
            "group": "punctuation",
            "subGroup": "basic"
          }
        ]
      }
    ],
    "nogroup": [
      "emoji",
      "symbols"
    ],
    "keymaps": {
      "custom1": {
        "name": "Gaming Layout",
        "keys": {
          "87": "W",
          "65": "A",
          "83": "S",
          "68": "D"
        }
      },
      "custom2": {
        "name": "Numeric Pad",
        "keys": {
          "96": "0",
          "97": "1",
          "98": "2",
          "99": "3"
        }
      }
    }
  }
}