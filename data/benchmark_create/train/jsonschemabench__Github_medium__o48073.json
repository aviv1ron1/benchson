            "email": "bob.jones@example.org",
            "irc": "bobj",
            "launchpad_id": "bobj"
          }
        ],
        "wiki": "https://example.com/wiki/e1000e",
        "releases": [
          "Jelly",
          "Kali"
        ],
        "ci": {
