{
  "name": "case_schema",
  "source": "schemas",
  "subset": null,
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://json.schemastore.org/case_schema.json",
    "definitions": {
      "request_body": {
        "type": "object"
      },
      "provider_data": {
        "type": "object",
        "description": "api or sql return data for later use",
        "properties": {
          "provider_type": {
            "type": "string",
            "default": "sql"
          },
          "provider_db": {
            "type": "string"
          },
          "api_id": {
            "type": "string"
          },
          "provider_sql": {
            "type": "string"
          },
          "request_body": {
            "$ref": "#/definitions/request_body"
          }
        }
      },
      "provider_datas": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/provider_data"
        }
      },
      "ready_data": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "default": "sql"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "properties": {
      "api": {
        "title": "api url info",
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "default": "https://dev-api.qiandao.cn"
          },
          "uri": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "header": {
            "type": "string"
          }
        }
      },
      "template": {
        "title": "set up data for all request",
        "type": "object",
        "properties": {
          "headers": {
            "type": "object",
            "properties": {
              "authorization": {
                "type": "string"
              }
            }
          },
          "request_body": {
            "$ref": "#/definitions/request_body"
          },
          "provider_data": {
            "$ref": "#/definitions/provider_datas"
          }
        }
      },
      "cases": {
        "title": "cases to test",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "case_id": {
              "type": "string"
            },
            "sleep": {
              "type": "integer",
              "description": "sleep after the case execution"
            },
            "describe": {
              "type": "string"
            },
            "assert": {
              "type": "object"
            },
            "request_body": {
              "$ref": "#/definitions/request_body"
            },
            "provider_data": {
              "$ref": "#/definitions/provider_datas"
            },
            "set_up": {
              "$ref": "#/definitions/ready_data",
              "type": "object"
            },
            "tear_down": {
              "$ref": "#/definitions/ready_data",
              "type": "object"
            }
          }
        }
      }
    },
    "description": "a schema for auto api cases",
    "title": "case",
    "type": "object"
  },
  "description": "The service under test is the user management API hosted at **https://dev-api.qiandao.cn**. All requests will target the **/v1/users** endpoint using the **POST** method and will include the header **Content\u2011Type: application/json** together with an authorization token **Bearer abcdef123456**. By default the request payload contains the fields\u202f`username: \"testuser\"` and\u202f`email: \"test@example.com\"`. Before any test runs, two provider actions are prepared: a SQL operation that inserts a new row into the **users_db** database with the statement `INSERT INTO users (username,email) VALUES (?,?)` using the same default payload, and an API call named **notifyService** that sends a JSON body `{\"message\":\"User created\",\"userId\":101}`.\n\n**Test case TC001** \u2013 *Create a new user and verify response* \u2013 will pause for **2\u202fseconds** after execution. It sends a request body of `{\"username\":\"newuser\",\"email\":\"newuser@example.com\"}` and expects a **201** status code with the response body containing the key **userId**. To support this, a SQL provider action **verifyUser** runs against **users_db** using the query `SELECT * FROM users WHERE email='newuser@example.com'` with the parameter `{\"email\":\"newuser@example.com\"}`. The test environment is cleaned both before and after the case with the SQL command `DELETE FROM users WHERE email='newuser@example.com';`.\n\n**Test case TC002** \u2013 *Fetch user details* \u2013 will pause for **1\u202fsecond** after execution. It posts the payload `{\"userId\":100}` and asserts that the response returns a **200** status code, that the JSON path `$.username` is present, and that its value equals **\"existinguser\"**. An API provider action **getUser** is invoked with the same `{\"userId\":100}` payload. The setup step performs an API call `POST /login {\"username\":\"existinguser\",\"password\":\"pass\"}` to obtain a session, while the teardown step logs out with `POST /logout {\"sessionId\":\"abc123\"}`.",
  "reference_json": {
    "api": {
      "host": "https://dev-api.qiandao.cn",
      "uri": "/v1/users",
      "method": "POST",
      "header": "Content-Type: application/json"
    },
    "template": {
      "headers": {
        "authorization": "Bearer abcdef123456"
      },
      "request_body": {
        "username": "testuser",
        "email": "test@example.com"
      },
      "provider_data": [
        {
          "provider_type": "sql",
          "provider_db": "users_db",
          "api_id": "createUser",
          "provider_sql": "INSERT INTO users (username,email) VALUES (?,?)",
          "request_body": {
            "username": "testuser",
            "email": "test@example.com"
          }
        },
        {
          "provider_type": "api",
          "provider_db": "",
          "api_id": "notifyService",
          "provider_sql": "",
          "request_body": {
            "message": "User created",
            "userId": 101
          }
        }
      ]
    },
    "cases": [
      {
        "case_id": "TC001",
        "sleep": 2,
        "describe": "Create a new user and verify response",
        "assert": {
          "status_code": 201,
          "body_contains": "userId"
        },
        "request_body": {
          "username": "newuser",
          "email": "newuser@example.com"
        },
        "provider_data": [
          {
            "provider_type": "sql",
            "provider_db": "users_db",
            "api_id": "verifyUser",
            "provider_sql": "SELECT * FROM users WHERE email='newuser@example.com'",
            "request_body": {
              "email": "newuser@example.com"
            }
          }
        ],
        "set_up": {
          "type": "sql",
          "content": "DELETE FROM users WHERE email='newuser@example.com';"
        },
        "tear_down": {
          "type": "sql",
          "content": "DELETE FROM users WHERE email='newuser@example.com';"
        }
      },
      {
        "case_id": "TC002",
        "sleep": 1,
        "describe": "Fetch user details",
        "assert": {
          "status_code": 200,
          "json_path": "$.username",
          "expected": "existinguser"
        },
        "request_body": {
          "userId": 100
        },
        "provider_data": [
          {
            "provider_type": "api",
            "provider_db": "",
            "api_id": "getUser",
            "provider_sql": "",
            "request_body": {
              "userId": 100
            }
          }
        ],
        "set_up": {
          "type": "api",
          "content": "POST /login {\"username\":\"existinguser\",\"password\":\"pass\"}"
        },
        "tear_down": {
          "type": "api",
          "content": "POST /logout {\"sessionId\":\"abc123\"}"
        }
      }
    ]
  }
}