{
  "name": "minecraft-texture-mcmeta",
  "source": "schemas",
  "subset": null,
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://json.schemastore.org/minecraft-texture-mcmeta.json",
    "description": "A mcmeta file for an animated texture for a Minecraft resource pack config schema",
    "oneOf": [
      {
        "properties": {
          "animation": {
            "description": "Animation",
            "type": "object",
            "properties": {
              "interpolate": {
                "type": "boolean",
                "default": false
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "frametime": {
                "type": "integer",
                "default": 1
              },
              "frames": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "index": {
                          "type": "integer"
                        },
                        "time": {
                          "type": "integer"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "required": [
          "animation"
        ]
      },
      {
        "properties": {
          "fusion": {
            "$comment": "Fusion properties for Minecraft texture metadata",
            "$ref": "https://json.schemastore.org/partial-fusion-texture-metadata.json#/definitions/fusion-properties"
          }
        },
        "required": [
          "fusion"
        ]
      }
    ],
    "title": "Minecraft Resource Pack Texture Mcmeta",
    "type": "object"
  },
  "description": "Hi team,\n\nI've set up the animated texture for the new 16\u202f\u00d7\u202f16 sprite. The animation will interpolate smoothly between frames, and each standard frame will display for two ticks. The sequence runs four frames long: it starts with frame\u202f0, proceeds to frame\u202f1, then shows frame\u202f2 for a longer pause of four ticks, and finally displays frame\u202f3 before looping back to the start.",
  "reference_json": {
    "animation": {
      "interpolate": true,
      "width": 16,
      "height": 16,
      "frametime": 2,
      "frames": [
        0,
        1,
        {
          "index": 2,
          "time": 4
        },
        3
      ]
    }
  }
}