{
  "name": "jsonld",
  "source": "schemas",
  "subset": null,
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "additionalProperties": true,
    "allOf": [
      {
        "$ref": "#/definitions/context"
      },
      {
        "$ref": "#/definitions/graph"
      },
      {
        "$ref": "#/definitions/common"
      }
    ],
    "definitions": {
      "context": {
        "additionalProperties": true,
        "properties": {
          "@context": {
            "description": "Used to define the short-hand names that are used throughout a JSON-LD document.",
            "type": [
              "object",
              "string",
              "array",
              "null"
            ]
          }
        }
      },
      "graph": {
        "additionalProperties": true,
        "properties": {
          "@graph": {
            "description": "Used to express a graph.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/common"
                }
              },
              {
                "$ref": "#/definitions/common",
                "type": "object"
              }
            ]
          }
        }
      },
      "common": {
        "additionalProperties": {
          "anyOf": [
            {
              "$ref": "#/definitions/common"
            }
          ]
        },
        "properties": {
          "@id": {
            "description": "Used to uniquely identify things that are being described in the document with IRIs or blank node identifiers.",
            "type": "string",
            "format": "uri"
          },
          "@value": {
            "description": "Used to specify the data that is associated with a particular property in the graph.",
            "type": [
              "string",
              "boolean",
              "number",
              "null"
            ]
          },
          "@language": {
            "description": "Used to specify the language for a particular string value or the default language of a JSON-LD document.",
            "type": [
              "string",
              "null"
            ]
          },
          "@type": {
            "description": "Used to set the data type of a node or typed value.",
            "type": [
              "string",
              "null",
              "array"
            ]
          },
          "@container": {
            "description": "Used to set the default container type for a term.",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "@language",
              "@list",
              "@index",
              "@set"
            ]
          },
          "@list": {
            "description": "Used to express an ordered set of data."
          },
          "@set": {
            "description": "Used to express an unordered set of data and to ensure that values are always represented as arrays."
          },
          "@reverse": {
            "description": "Used to express reverse properties.",
            "type": [
              "string",
              "object",
              "null"
            ],
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/definitions/common"
                }
              ]
            }
          },
          "@base": {
            "description": "Used to set the base IRI against which relative IRIs are resolved",
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "@vocab": {
            "description": "Used to expand properties and values in @type with a common prefix IRI",
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "id": "https://json.schemastore.org/jsonld.json",
    "title": "Schema for JSON-LD",
    "type": [
      "object",
      "array"
    ]
  },
  "description": "In our contact directory we adopt the\u202fschema.org\u202fvocabulary (base IRI\u202fhttp://example.org/\u202fand default vocab\u202fhttp://schema.org/).  The compact term **name** expands to\u202fschema:name, **knows** expands to\u202fschema:knows\u202fand is treated as an IRI, and **homepage** expands to\u202fschema:url\u202fand is also treated as an IRI.  \n\nAlice is identified by the IRI\u202fhttp://example.org/person/alice\u202fand is a\u202fschema:Person.  Her name is \u201cAlice\u201d (English), she knows\u202fhttp://example.org/person/bob, and her personal homepage is\u202fhttp://alice.example.org.  The reverse relationship shows that\u202fhttp://example.org/person/charlie\u202falso knows Alice.  \n\nBob is identified by the IRI\u202fhttp://example.org/person/bob\u202fand is likewise a\u202fschema:Person.  His name is \u201cBob\u201d (English).",
  "reference_json": {
    "@context": {
      "schema": "http://schema.org/",
      "name": "schema:name",
      "knows": {
        "@id": "schema:knows",
        "@type": "@id"
      },
      "homepage": {
        "@id": "schema:url",
        "@type": "@id"
      }
    },
    "@graph": [
      {
        "@id": "http://example.org/person/alice",
        "@type": "schema:Person",
        "schema:name": {
          "@value": "Alice",
          "@language": "en"
        },
        "schema:knows": {
          "@id": "http://example.org/person/bob"
        },
        "schema:homepage": {
          "@id": "http://alice.example.org"
        },
        "@reverse": {
          "schema:knows": {
            "@id": "http://example.org/person/charlie"
          }
        }
      },
      {
        "@id": "http://example.org/person/bob",
        "@type": "schema:Person",
        "schema:name": {
          "@value": "Bob",
          "@language": "en"
        }
      }
    ],
    "@base": "http://example.org/",
    "@vocab": "http://schema.org/"
  }
}