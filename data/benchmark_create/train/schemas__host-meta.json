{
  "name": "host-meta",
  "source": "schemas",
  "subset": null,
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "additionalProperties": true,
    "definitions": {
      "property": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "link": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "format": "uri"
          },
          "titles": {
            "type": "object",
            "properties": {
              "default": {
                "type": "string"
              }
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "properties": {
            "$ref": "#/definitions/property"
          }
        }
      }
    },
    "id": "https://json.schemastore.org/host-meta.json",
    "properties": {
      "subject": {
        "type": "string",
        "format": "uri"
      },
      "expires": {
        "type": "string",
        "format": "date-time"
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "properties": {
        "$ref": "#/definitions/property"
      },
      "links": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/link"
        }
      }
    },
    "required": [
      "subject"
    ],
    "title": "JSON schema for host-meta files",
    "type": "object"
  },
  "description": "The host\u2011meta record for **https://example.com** is currently valid through **2027\u201101\u201101T00:00:00Z**. In addition to the primary host, the same metadata applies to the aliases **https://www.example.com** and **https://blog.example.com**. Under the general properties, the host name is listed as **example.com**, and no administrator is specified.\n\nTwo important links are advertised. The first, with the relation **lrdd**, points to the WebFinger endpoint at **https://example.com/.well-known/webfinger**. It serves JSON (`application/json`) and is titled \u201cWebFinger endpoint\u201d (English title \u201cWebFinger\u201d). This endpoint is reachable via a **GET** request and does not require any authentication.  \n\nThe second link has the relation **profile-page** and leads to the user profile page at **https://example.com/profile**. A URL template **https://example.com/profile/{uri}** is provided for constructing direct links to individual profiles, and the link is titled \u201cUser profile\u201d.",
  "reference_json": {
    "subject": "https://example.com",
    "expires": "2027-01-01T00:00:00Z",
    "aliases": [
      "https://www.example.com",
      "https://blog.example.com"
    ],
    "properties": {
      "host": "example.com",
      "admin": null
    },
    "links": [
      {
        "rel": "lrdd",
        "type": "application/json",
        "href": "https://example.com/.well-known/webfinger",
        "titles": {
          "default": "WebFinger endpoint",
          "en": "WebFinger"
        },
        "properties": {
          "method": "GET",
          "auth": null
        }
      },
      {
        "rel": "profile-page",
        "href": "https://example.com/profile",
        "template": "https://example.com/profile/{uri}",
        "titles": {
          "default": "User profile"
        }
      }
    ]
  }
}