          "uniqueItems": true
        }
      }
    },
    "required": [
      "requirements"
    ],
    "title": "Solidarity",
    "type": "object"
  },
  "description": "The configuration is set to produce verbose output for all checks.  \n\nFor the **node** requirements, the system must locate the `node` binary and verify that its version satisfies the semver range **^14.0.0**; this check runs on the **linux** platform and is not required in continuous\u2011integration environments. Additionally, the environment variable **NODE_ENV** must be present on **linux**; if it is missing the error \u201cNODE_ENV not set\u201d will be reported, and this variable is mandatory for CI runs.  \n\nThe **projectFiles** rules ensure that the directory `./src` exists on the **darwin** platform and that the file `./package.json` is present on the same platform; neither of these checks is needed for CI. A custom rule named **checkVersion** provided by the plugin **my\u2011plugin** looks for a version string matching the regular expression `\\d+\\.\\d+\\.\\d+`; this custom check is executed in CI. Finally, a shell rule verifies that the command output contains the text \u201cDocker version\u201d on **linux**, and this check is not required for CI.",
  "reference_json": {
    "config": {
      "output": "verbose"
    },
    "requirements": {
      "node": [
        {
          "rule": "cli",
          "binary": "node",
          "semver": "^14.0.0",
          "platform": "linux",
          "ci": false
        },
        {
          "rule": "env",
          "variable": "NODE_ENV",
          "platform": "linux",
          "error": "NODE_ENV not set",
          "ci": true
        }
      ],
      "projectFiles": [
        {
          "rule": "dir",
          "location": "./src",
          "platform": "darwin",
          "ci": false
        },
        {
          "rule": "file",
          "location": "./package.json",
          "platform": "darwin",
          "ci": false
        }
      ],
      "customCheck": [
        {
          "rule": "custom",
          "plugin": "my-plugin",
          "name": "checkVersion",
          "match": "\\d+\\.\\d+\\.\\d+",
          "ci": true
        }
      ],
      "docker": [
        {
          "rule": "shell",
          "match": "Docker version",
          "platform": "linux",
          "ci": false
        }
      ]
    }
  }
}