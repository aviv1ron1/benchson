        "ConnectionString": "Server=config.server;Database=Config;Trusted_Connection=True;"
      },
      "Helpers": [
        {
          "Name": "HelperDB1",
          "Database": "Helper1",
          "ConnectionString": "Server=helper1.server;Database=Helper1;Trusted_Connection=True;"
        },
        {
