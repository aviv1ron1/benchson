{
  "name": "o41349",
  "source": "jsonschemabench",
  "subset": "Github_hard",
  "schema": {
    "title": "Invocation manifest for Pydeface Gear",
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "config": {
        "type": "object",
        "properties": {
          "cost": {
            "type": "string",
            "default": "mutualinfo",
            "enum": [
              "mutualinfo",
              "corratio",
              "normcorr",
              "normmi",
              "leastsq",
              "labeldiff",
              "bbr"
            ]
          },
          "nocleanup": {
            "type": "boolean",
            "default": true
          },
          "verbose": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "cost",
          "nocleanup",
          "verbose"
        ]
      },
      "inputs": {
        "type": "object",
        "properties": {
          "infile": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "nifti"
                ]
              }
            }
          },
          "template": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "nifti"
                ]
              }
            }
          },
          "facemask": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "nifti"
                ]
              }
            }
          }
        },
        "required": [
          "infile"
        ]
      }
    },
    "required": [
      "config",
      "inputs"
    ]
  },
  "description": "Dear Team,\n\nFor the upcoming Pydeface run I have configured the registration to use the normalized mutual information (normmi) cost function. Cleanup of intermediate files has been turned off, and the process will run in verbose mode so we can monitor each step. The primary input is a NIfTI image, and both the template and the facial mask are also supplied as NIfTI files. Please let me know if any adjustments are needed before we launch the job.",
  "reference_json": {
    "config": {
      "cost": "normmi",
      "nocleanup": false,
      "verbose": true
    },
    "inputs": {
      "infile": {
        "type": "nifti"
      },
      "template": {
        "type": "nifti"
      },
      "facemask": {
        "type": "nifti"
      }
    }
  }
}