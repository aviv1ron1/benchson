{
  "name": "apple-app-site-association",
  "source": "schemas",
  "subset": null,
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "An Apple Universal Link config schema",
    "id": "https://json.schemastore.org/apple-app-site-association.json",
    "properties": {
      "applinks": {
        "title": "application links",
        "description": "Application links",
        "type": "object",
        "required": [
          "apps",
          "details"
        ],
        "properties": {
          "apps": {
            "description": "Applications",
            "type": "array",
            "enum": [
              []
            ]
          },
          "details": {
            "description": "Details",
            "type": "array",
            "items": {
              "title": "detail",
              "description": "A detail",
              "type": "object",
              "properties": {
                "appID": {
                  "description": "An appID key or app ID prefix, followed by the bundle ID",
                  "type": "string"
                },
                "paths": {
                  "description": "Paths",
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "https://json.schemastore.org/base-04.json#/definitions/path",
                    "description": "Path to open in the mobile app"
                  }
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "applinks"
    ],
    "title": "Apple Universal Link config",
    "type": "object"
  },
  "description": "Dear team,\n\nThe Apple Universal Link configuration has been finalized for our site. The associated iOS application is identified by the app ID\u202f`ABCDE12345.com.example.myapp`. According to the settings, any request to the root URL \u201c/\u201d, as well as any URLs under \u201c/products/\u201d (e.g., \u201c/products/*\u201d) or \u201c/sale/\u201d (e.g., \u201c/sale/*\u201d), should be routed directly to this app. No other apps are listed in the configuration.",
  "reference_json": {
    "applinks": {
      "apps": [],
      "details": [
        {
          "appID": "ABCDE12345.com.example.myapp",
          "paths": [
            "/",
            "/products/*",
            "/sale/*"
          ]
        }
      ]
    }
  }
}