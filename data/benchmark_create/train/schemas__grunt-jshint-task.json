{
  "name": "grunt-jshint-task",
  "source": "schemas",
  "subset": null,
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "additionalProperties": {
      "anyOf": [
        {
          "$ref": "https://json.schemastore.org/grunt-task#/definitions/fileFormat"
