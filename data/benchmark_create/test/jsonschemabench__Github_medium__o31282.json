                },
                "parameters": {
                  "type": "object"
                }
              },
              "required": [
                "type",
                "parameters"
              ]
            }
          }
        }
      },
      "deviceGroups": {
        "type": "array",
        "items": {
          "properties": {
            "name": {
              "type": "string"
            },
            "devices": {
              "type": "array",
              "items": {
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "deviceSecret": {
                    "type": "string"
                  }
                },
                "required": [
                  "deviceId",
                  "deviceSecret"
                ]
              }
            },
            "jobs": {
              "type": "array",
              "items": {
                "properties": {
