          "namespaceAliases": {
            "type": "array",
            "items": {
              "properties": {
                "alias": {
                  "type": "string"
                },
                "namespace": {
                  "type": "string"
                }
              },
              "required": [
                "alias",
                "namespace"
              ]
            }
          },
          "defaultParameters": {
            "type": "array",
            "items": {
              "properties": {
                "type": {
