        "match": ".*\\.py$",
        "ruleSet": "security",
        "reason": "Apply security linting to backend Python modules",
        "author": "Bob Smith",
        "date": "2024-01-10"
      }
    ],
    "deny": [
      "*.tmp",
      "*.bak"
    ],
    "exclude": [
      "node_modules/",
      "dist/"
    ],
    "reject": [
      "debug=true",
      "verbose=1"
    ],
    "replace": [
      "foo=>bar",
