    "general": {
      "description": "Top-level process manager configuration",
      "heartbeat": 30,
      "weight": 10,
      "worker_affinity": [
        "worker1",
        "worker2"
      ],
      "pass_binary_messages": true,
      "wrapper": {
        "log_level": "info",
        "ping_parent_timeout": 5000,
        "ping_parent_interval": 1000,
        "ping_child_timeout": 3000,
        "ping_child_interval": 500
      },
      "initialization": [
        {
          "working_dir": "/opt/init",
          "cmd": "node init.js",
          "init": {
            "step": "prepare"
          },
          "disabled": false
        }
      ],
      "shutdown": [
        {
          "working_dir": "/opt/shutdown",
          "cmd": "node stop.js",
          "init": {},
          "disabled": false
        }
      ],
      "shutdown_hard": [
        {
          "working_dir": "/opt/shutdown_hard",
          "cmd": "kill -9 $(cat pidfile)",
          "init": {},
          "disabled": false
        }
      ]
    },
    "spouts": [
      {
        "name": "sourceSpout",
        "description": "Generates data streams",
        "type": "module_class",
        "disabled": false,
        "working_dir": "/opt/spouts",
        "cmd": "node source.js",
        "subtype": "json",
        "telemetry_timeout": 5.0,
        "init": {
          "bufferSize": "1024"
        }
      }
    ],
    "bolts": [
      {
        "name": "processorBolt",
        "description": "Processes incoming data",
        "type": "module_class",
        "disabled": false,
        "working_dir": "/opt/bolts",
        "cmd": "node process.js",
        "subtype": "filter",
        "telemetry_timeout": 10.0,
        "inputs": [
          {
            "source": "sourceSpout",
            "stream_id": "default",
            "disabled": false
          }
        ],
        "init": {
          "threshold": "0.75"
        },
        "allow_parallel": true
      }
    ],
    "variables": {
      "ENV": "production",
      "MAX_RETRIES": "5",
      "LOG_PATH": "/var/log/nodepm"
    }
  },
