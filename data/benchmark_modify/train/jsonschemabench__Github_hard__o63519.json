          "required": [
            "release_name",
            "end_date"
          ],
          "additionalProperties": false
        }
      },
      "repos": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string"
            },
            "organization": {
              "type": "string"
            },
            "module": {
              "type": "string"
            },
            "releases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "branch": {
                    "type": "string"
                  },
                  "tag_from": {
                    "type": "string"
                  },
                  "tag_to": {
                    "type": "string"
                  },
                  "release_name": {
                    "type": "string"
                  }
                },
