            "module_group_name": {
              "type": "string",
              "pattern": "^[\\w-]+$"
            },
            "modules": {
              "type": [
                "array"
              ],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "module_group_name",
            "modules"
          ],
          "additionalProperties": false
        }
