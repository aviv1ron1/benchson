          "type": "object",
          "properties": {
            "organization": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            },
            "git_base_uri": {
              "type": "string"
            },
            "ssh_key_filename": {
              "type": "string"
            },
            "ssh_username": {
              "type": "string"
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "organization"
          ],
          "additionalProperties": false
        }
      },
      "module_groups": {
        "type": "array",
