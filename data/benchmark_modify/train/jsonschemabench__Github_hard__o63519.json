              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "uri",
            "module",
            "organization"
          ],
          "additionalProperties": false
        }
      },
      "companies": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "company_name": {
              "type": "string"
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z\\d\\.-]*$"
              }
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "company_name",
            "domains"
          ],
          "additionalProperties": false
        }
      },
      "project_sources": {
        "type": "array",
