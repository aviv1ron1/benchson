{
  "name": "o12283",
  "source": "jsonschemabench",
  "subset": "Github_medium",
  "schema": {
    "$schema": "http://json-schema.org/draft-06/schema#",
    "title": "Mapping",
    "description": "A mapping used by Glue to extract findings from a security tool report",
    "type": "object",
    "required": [
      "task_name",
      "app_name",
      "mappings"
    ],
    "properties": {
      "task_name": {
        "type": "string",
        "description": "The name of the task (tool) the produce those findings"
      },
      "app_name": {
        "type": "string",
        "description": "Path to the property in the report file that contains the target app name"
      },
      "mappings": {
        "type": "array",
        "description": "An array of mappings",
        "items": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "The key in the JSON report to an array that contains findings"
            },
            "properties": {
              "type": "object",
              "description": "The mapping between the items in the array and Glue's findings",
              "required": [
                "description",
                "detail",
                "source",
                "severity",
                "fingerprint"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "description": "The path on the array item to extract the description"
                },
                "detail": {
                  "type": "string",
                  "description": "The path on the array item to extract the details"
                },
                "source": {
                  "type": "string",
                  "description": "The path on the array item to extract the source"
                },
                "severity": {
                  "type": "string",
                  "description": "The path on the array item to extract the severity"
                },
                "fingerprint": {
                  "type": "string",
                  "description": "The path on the array item to extract the fingerprint"
                }
              }
            }
          }
        }
      }
    }
  },
  "data": {
    "task_name": "SnykScan",
    "app_name": "metadata.application.name",
    "mappings": [
      {
        "key": "vulnerabilities",
        "properties": {
          "description": "issue.title",
          "detail": "issue.description",
          "source": "issue.source",
          "severity": "issue.severityLevel",
          "fingerprint": "issue.id"
        }
      }
    ]
  },
  "instructions": "Please change the\u202ftask_name\u202ffield to\u202f\"SnykScan (updated)\".",
  "ground_truth": {
    "task_name": "SnykScan (updated)",
    "app_name": "metadata.application.name",
    "mappings": [
      {
        "key": "vulnerabilities",
        "properties": {
          "description": "issue.title",
          "detail": "issue.description",
          "source": "issue.source",
          "severity": "issue.severityLevel",
          "fingerprint": "issue.id"
        }
      }
    ]
  },
  "modification": {
    "op": "set_string",
    "path": [
      "task_name"
    ],
    "precise_instruction": "Change \"task_name\" to \"SnykScan (updated)\"."
  }
}