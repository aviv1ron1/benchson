  "data": {
    "name": "DeepText Analyzer",
    "description": "A project for analyzing large corpora of text with deep learning models.",
    "repo": "https://github.com/example/deeptext-analyzer",
    "documentation": "https://example.github.io/deeptext-analyzer/docs",
    "tags": [
      "nlp",
      "deep-learning",
      "text-analysis",
      "python"
    ],
    "cluster": {
      "config": "conf/cluster.yaml",
      "params": [
        {
          "name": "num_nodes",
          "help": "Number of compute nodes to allocate",
          "type": "int",
          "default": 2,
          "choices": [
            1,
            2,
            4,
            8
          ]
        },
        {
          "name": "gpu_type",
          "help": "Type of GPU to request",
          "type": "str",
          "default": "V100",
          "choices": [
            "V100",
            "A100",
            "K80"
          ]
        }
      ]
    },
    "environment": {
      "dockerimage": "docker.io/example/deeptext:latest",
      "dockerfile": "Dockerfile",
      "requirements": "requirements.txt",
      "shell": [
        "pip install -e .",
        "python -m spacy download en_core_web_sm"
      ]
    },
    "commands": [
      {
        "name": "train",
        "help": "Train the NLP model on the dataset",
        "command": "python train.py --epochs {epochs} --batch-size {batch_size}",
        "params": [
          {
            "name": "epochs",
            "help": "Number of training epochs",
            "type": "int",
            "default": 10,
            "choices": [
              5,
              10,
              20,
              50
            ]
          },
          {
            "name": "batch_size",
            "help": "Batch size for training",
            "type": "int",
            "default": 32,
            "choices": [
              16,
              32,
              64,
              128
            ]
          }
        ],
        "config": {
          "tmux": true
        }
      },
      {
        "name": "evaluate",
        "help": "Run evaluation on the test set",
        "command": "python evaluate.py --model-path {model_path}",
        "params": [
          {
            "name": "model_path",
            "help": "Path to the trained model checkpoint",
            "type": "str",
            "default": "models/latest.pt"
          }
        ],
        "config": {
          "tmux": false
        }
      }
    ],
    "output_files": [
      "models/latest.pt",
      "reports/metrics.json",
      "logs/train.log"
    ]
  },
