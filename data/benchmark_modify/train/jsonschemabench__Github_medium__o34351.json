                            }
                          },
                          "required": [
                            "min",
                            "max"
                          ]
                        }
                      },
                      "required": [
                        "function",
                        "count"
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "name"
                ]
              }
            }
          },
          "conditions": {
            "$ref": "#/definitions/conditions"
          },
          "required": [
            "rolls"
          ]
        }
      }
