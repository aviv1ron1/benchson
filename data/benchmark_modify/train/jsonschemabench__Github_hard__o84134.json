        "PORT": 3000,
        "DEBUG": false
      },
      "expose": [
        3000
      ],
      "extends": {
        "service": "base",
        "file": "docker-compose.base.yml"
      },
      "extra_hosts": {
        "host.docker.internal": "host-gateway"
      },
      "external_links": [
        "redis:redis"
      ],
      "hostname": "webhost",
      "image": "node:14-alpine",
      "ipc": "shareable",
      "labels": [
        "traefik.enable=true",
        "com.example.description=Web service"
      ],
      "links": [
        "db"
      ],
      "log_driver": "json-file",
      "log_opt": {
        "max-size": "10m",
        "max-file": "3"
      },
      "mac_address": "02:42:ac:11:00:02",
      "mem_limit": "512m",
      "memswap_limit": "1g",
      "name": "web_service",
      "net": "frontend",
      "pid": null,
      "ports": [
        "80:80",
        "443:443"
      ],
      "privileged": false,
      "read_only": false,
      "restart": "always",
