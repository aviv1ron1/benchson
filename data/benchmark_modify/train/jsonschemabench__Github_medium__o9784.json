          },
          {
            "type": "string",
            "enum": [
              "none"
            ]
          }
        ]
      },
      "pubTopics": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "subTopics": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "additionalProperties": false
  },
