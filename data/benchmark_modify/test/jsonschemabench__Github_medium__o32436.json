                      },
                      "firstChoices": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "candidate",
                      "firstChoices"
                    ],
                    "additionalProperties": false
                  }
                },
                "eliminated": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "required": [
          "winner"
        ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "dependencies": {
