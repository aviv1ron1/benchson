{
  "name": "o91148",
  "source": "jsonschemabench",
  "subset": "Github_easy",
  "schema": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "allChunks": {
        "description": "",
        "type": "boolean"
      },
      "disable": {
        "description": "",
        "type": "boolean"
      },
      "fallback": {
        "description": "A loader that webpack can fall back to if the original one fails.",
        "modes": {
          "type": "array"
        }
      },
      "filename": {
        "description": "The filename and path that ExtractTextPlugin will extract to",
        "modes": {
          "type": "function"
        }
      },
      "ignoreOrder": {
        "description": "Ignore dependency order (useful for CSS Modules)",
        "type": "boolean"
      },
      "loader": {
        "description": "The loader that ExtractTextPlugin will attempt to load through.",
        "modes": {
          "type": "array"
        }
      },
      "publicPath": {
        "description": "",
        "type": "string"
      }
    }
  },
  "data": {
    "allChunks": true,
    "disable": false,
    "fallback": [
      "style-loader"
    ],
    "filename": "css/[name].css",
    "ignoreOrder": false,
    "loader": [
      "css-loader",
      "postcss-loader"
    ],
    "publicPath": "/static/"
  },
  "instructions": "Can you remove the loader field?",
  "ground_truth": {
    "allChunks": true,
    "disable": false,
    "fallback": [
      "style-loader"
    ],
    "filename": "css/[name].css",
    "ignoreOrder": false,
    "publicPath": "/static/"
  },
  "modification": {
    "op": "delete_field",
    "path": [
      "loader"
    ],
    "precise_instruction": "Remove the \"loader\" field."
  }
